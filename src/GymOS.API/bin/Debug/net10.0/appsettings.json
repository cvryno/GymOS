{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Quartz": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=GymOSDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Database": {
    "UseSqlServer": false
  },
  "DisableHttpsRedirection": true,
  "Jwt": {
    "Key": "",
    "Issuer": "GymOS.API",
    "Audience": "GymOS.Frontend",
    "ExpiryMinutes": "60"
  },
  "Google": {
    "ClientId": "YOUR_GOOGLE_CLIENT_ID",
    "ClientSecret": "YOUR_GOOGLE_CLIENT_SECRET"
  },
  "WhatsApp": {
    "PhoneNumberId": "YOUR_WHATSAPP_PHONE_NUMBER_ID",
    "AccessToken": "YOUR_WHATSAPP_ACCESS_TOKEN",
    "GymName": "GymOS"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  }
}
